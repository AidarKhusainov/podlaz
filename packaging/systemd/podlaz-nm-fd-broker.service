[Unit]
Description=Podlaz optional NM-owned TUN FD broker (not enabled by default)
Documentation=man:podlazd(8)
After=network.target NetworkManager.service
Requires=NetworkManager.service
ConditionPathExists=/dev/net/tun

[Service]
Type=simple
ExecStart=/usr/bin/podlazd --nm-owned-fd-broker
Restart=no
User=root
Group=root
UMask=0077
RuntimeDirectory=podlaz-nm-fd
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SETUID CAP_SETGID CAP_SETPCAP
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SETUID CAP_SETGID CAP_SETPCAP
Delegate=yes
ProtectControlGroups=no
ProtectSystem=strict
ReadWritePaths=/run/podlaz
ProtectHome=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
KillMode=control-group
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=podlaz-nm-fd-broker

# Deliberately no [Install]: manual opt-in only. The default podlazd service
# never inherits this unit's additional capabilities or writable cgroup.
