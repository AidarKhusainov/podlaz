#!/bin/sh
set -eu

unit=podlazd.service
marker_dir="${PODLAZ_MAINTSCRIPT_RUN_DIR:-/run/podlaz-maintscript}"
marker="$marker_dir/repair-helper-enable"
runtime_dir="${PODLAZ_RUNTIME_DIR:-/run/podlaz}"
boot_id_path="${PODLAZ_BOOT_ID_PATH:-/proc/sys/kernel/random/boot_id}"
systemd_runtime_dir="${PODLAZ_SYSTEMD_RUNTIME_DIR:-/run/systemd/system}"
continuation="$runtime_dir/network-session-continuation.json"
legacy_upgrade_marker="$runtime_dir/legacy-upgrade-continuation"
# systemctl show serializes signal properties numerically on supported Linux arches.
candidate_restart_signal_number=10
legacy_restart_signal_number=15
legacy_override_dir="$systemd_runtime_dir/$unit.d"
legacy_override="$legacy_override_dir/50-podlaz-legacy-replacement.conf"
legacy_override_installed=0

start_service() {
	deb-systemd-invoke start "$1" >/dev/null
}

try_restart_service() {
	deb-systemd-invoke try-restart "$1" >/dev/null
}

reload_systemd() {
	if ! command -v systemctl >/dev/null 2>&1; then
		return 0
	fi
	systemctl daemon-reload >/dev/null 2>&1 || true
}

reload_systemd_required() {
	if ! command -v systemctl >/dev/null 2>&1; then
		return 1
	fi
	systemctl daemon-reload >/dev/null
}

is_enabled() {
	if ! command -v systemctl >/dev/null 2>&1; then
		return 0
	fi
	systemctl is-enabled --quiet "$1" >/dev/null 2>&1
}

is_active() {
	if ! command -v systemctl >/dev/null 2>&1; then
		return 1
	fi
	systemctl is-active --quiet "$1" >/dev/null 2>&1
}

systemd_property() {
	systemctl show --property="$2" --value "$1" 2>/dev/null
}

loaded_restart_signal() {
	systemd_property "$1" RestartKillSignal
}

assert_legacy_source_contract_loaded() {
	restart_signal="$2"
	kill_mode="$(systemd_property "$1" KillMode)" || return 1
	runtime_preserve="$(systemd_property "$1" RuntimeDirectoryPreserve)" || return 1
	if [ "$restart_signal" != "$legacy_restart_signal_number" ] || [ "$kill_mode" != control-group ] || [ "$runtime_preserve" != no ]; then
		echo "podlaz: active pre-continuation service does not match the supported legacy replacement contract" >&2
		return 1
	fi
}

assert_legacy_replacement_contract_loaded() {
	restart_signal="$(systemd_property "$1" RestartKillSignal)" || return 1
	kill_mode="$(systemd_property "$1" KillMode)" || return 1
	runtime_preserve="$(systemd_property "$1" RuntimeDirectoryPreserve)" || return 1
	if [ "$restart_signal" != 9 ] || [ "$kill_mode" != control-group ] || [ "$runtime_preserve" != yes ]; then
		echo "podlaz: legacy replacement systemd contract was not loaded" >&2
		return 1
	fi
}

assert_candidate_restart_contract_loaded() {
	restart_signal="$(systemd_property "$1" RestartKillSignal)" || return 1
	kill_mode="$(systemd_property "$1" KillMode)" || return 1
	runtime_preserve="$(systemd_property "$1" RuntimeDirectoryPreserve)" || return 1
	if [ "$restart_signal" != "$candidate_restart_signal_number" ] || [ "$kill_mode" != mixed ] || [ "$runtime_preserve" != yes ]; then
		echo "podlaz: candidate restart systemd contract was not restored" >&2
		return 1
	fi
}

prepare_legacy_upgrade_continuation() {
	# Releases that predate network-session-continuation cannot preserve their
	# connect intent across the first package restart. Authorize the new daemon
	# to reconstruct it only from exact current-boot transaction-owned runtime
	# state. This marker contains no profile data and is not cleanup authority.
	if [ -e "$continuation" ]; then
		return 0
	fi
	if [ ! -d "$runtime_dir" ] || [ ! -r "$boot_id_path" ]; then
		return 1
	fi

	boot_id="$(cat "$boot_id_path" 2>/dev/null || true)"
	if [ -z "$boot_id" ]; then
		return 1
	fi

	old_umask="$(umask)"
	umask 077
	tmp="$runtime_dir/.legacy-upgrade-continuation.$$"
	if ! printf '%s\n' "$boot_id" > "$tmp"; then
		umask "$old_umask"
		return 1
	fi
	chmod 0600 "$tmp" >/dev/null 2>&1 || {
		rm -f "$tmp" >/dev/null 2>&1 || true
		umask "$old_umask"
		return 1
	}
	if ! mv -f "$tmp" "$legacy_upgrade_marker"; then
		rm -f "$tmp" >/dev/null 2>&1 || true
		umask "$old_umask"
		return 1
	fi
	umask "$old_umask"

	# The marker is replacement authority. Flush the filesystem containing the
	# runtime directory before any process replacement can begin.
	if ! command -v sync >/dev/null 2>&1 || ! sync -f "$runtime_dir"; then
		return 1
	fi
}

install_legacy_replacement_override() {
	# v0.2.29 does not understand the candidate restart signal, while SIGTERM
	# would run its ordinary disconnect path and destroy migration evidence.
	# For this one cross-version cutover, make systemd replace the exact service
	# cgroup (daemon + supervised Xray) immediately. The newly loaded candidate
	# RuntimeDirectoryPreserve contract keeps exact transaction/runtime authority.
	install -d -m 0755 "$legacy_override_dir"
	old_umask="$(umask)"
	umask 022
	tmp="$legacy_override_dir/.legacy-replacement.$$"
	if ! cat > "$tmp" <<'DROPIN'
[Service]
RestartKillSignal=SIGKILL
KillMode=control-group
DROPIN
	then
		umask "$old_umask"
		return 1
	fi
	chmod 0644 "$tmp"
	mv -f "$tmp" "$legacy_override"
	umask "$old_umask"
	legacy_override_installed=1
}

cleanup_legacy_replacement_override_best_effort() {
	if [ "$legacy_override_installed" -ne 1 ]; then
		return 0
	fi
	rm -f "$legacy_override" >/dev/null 2>&1 || true
	rmdir "$legacy_override_dir" >/dev/null 2>&1 || true
	if command -v systemctl >/dev/null 2>&1; then
		systemctl daemon-reload >/dev/null 2>&1 || true
	fi
	legacy_override_installed=0
}

cleanup_legacy_replacement_override() {
	if [ "$legacy_override_installed" -ne 1 ]; then
		return 0
	fi
	rm -f "$legacy_override"
	rmdir "$legacy_override_dir" >/dev/null 2>&1 || true
	reload_systemd_required
	assert_candidate_restart_contract_loaded "$unit"
	legacy_override_installed=0
}

assert_service_transition_succeeded() {
	if ! command -v systemctl >/dev/null 2>&1; then
		return 0
	fi
	result="$(systemctl show --property=Result --value "$1" 2>/dev/null)" || return 1
	if [ "$result" != success ]; then
		echo "podlaz: $1 transition failed with systemd Result=${result:-unknown}" >&2
		return 1
	fi
}

repair_stale_enablement() {
	if [ ! -e "$marker" ]; then
		return 0
	fi
	rm -f "$marker" >/dev/null 2>&1 || true

	if ! command -v systemctl >/dev/null 2>&1; then
		return 0
	fi
	if systemctl is-enabled --quiet "$1" >/dev/null 2>&1; then
		return 0
	fi
	if ! deb-systemd-helper debian-installed "$1" >/dev/null 2>&1; then
		return 0
	fi
	if ! deb-systemd-helper was-enabled "$1" >/dev/null 2>&1; then
		return 0
	fi

	deb-systemd-helper reenable "$1" >/dev/null || true
	deb-systemd-helper update-state "$1" >/dev/null || true
}

if [ "${1:-configure}" != "configure" ]; then
	exit 0
fi

if command -v systemd-sysusers >/dev/null 2>&1; then
	systemd-sysusers /usr/lib/sysusers.d/podlaz.conf || true
fi

if command -v deb-systemd-helper >/dev/null 2>&1; then
	deb-systemd-helper unmask "$unit" >/dev/null || true
	deb-systemd-helper enable "$unit" >/dev/null || true
	deb-systemd-helper update-state "$unit" >/dev/null || true
	repair_stale_enablement "$unit"
else
	rm -f "$marker" >/dev/null 2>&1 || true
fi

service_enabled=0
service_was_active=0
legacy_replacement=0
if command -v deb-systemd-invoke >/dev/null 2>&1 && is_enabled "$unit"; then
	service_enabled=1
	if is_active "$unit"; then
		service_was_active=1
		if [ ! -e "$continuation" ]; then
			old_restart_signal_number="$(loaded_restart_signal "$unit")" || {
				echo "podlaz: cannot inspect loaded restart signal before package replacement" >&2
				exit 1
			}
			if [ -z "$old_restart_signal_number" ]; then
				echo "podlaz: loaded restart signal is unavailable before package replacement" >&2
				exit 1
			fi
			if [ "$old_restart_signal_number" = "$candidate_restart_signal_number" ] && [ -e "$legacy_upgrade_marker" ]; then
				echo "podlaz: unresolved legacy migration authority remains; refusing normal service restart" >&2
				exit 1
			fi
			if [ "$old_restart_signal_number" != "$candidate_restart_signal_number" ]; then
				assert_legacy_source_contract_loaded "$unit" "$old_restart_signal_number"
				prepare_legacy_upgrade_continuation
				install_legacy_replacement_override
				legacy_replacement=1
			fi
		fi
	fi
fi

if [ "$legacy_replacement" -eq 1 ]; then
	trap 'cleanup_legacy_replacement_override_best_effort' EXIT
	trap 'cleanup_legacy_replacement_override_best_effort; exit 1' HUP INT TERM
	reload_systemd_required
	assert_legacy_replacement_contract_loaded "$unit"
else
	reload_systemd
fi

if [ "$service_enabled" -eq 1 ]; then
	if [ "$service_was_active" -eq 1 ]; then
		try_restart_service "$unit"
	else
		start_service "$unit"
	fi
	assert_service_transition_succeeded "$unit"
fi

if [ "$legacy_replacement" -eq 1 ]; then
	cleanup_legacy_replacement_override
	trap - EXIT HUP INT TERM
fi

exit 0
