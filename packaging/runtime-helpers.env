# Pinned third-party runtime helper inputs used by scripts/package-runtime-helpers.sh.
# Keep versions, asset names, and checksums together so package builds are reproducible
# and fail closed when upstream assets change.

XRAY_VERSION=v26.3.27
XRAY_AMD64_ASSET=Xray-linux-64.zip
XRAY_AMD64_SHA256=23cd9af937744d97776ee35ecad4972cf4b2109d1e0fe6be9930467608f7c8ae
XRAY_ARM64_ASSET=Xray-linux-arm64-v8a.zip
XRAY_ARM64_SHA256=4d30283ae614e3057f730f67cd088a42be6fdf91f8639d82cb69e48cde80413c

# Dormant, separately pinned official upstream Linux inherited-FD runtime.
# It must not replace the default Xray or be activated before the NM supervisor
# and its Privacy Envelope/confinement/admission contract are implemented.
XRAY_NM_VERSION=v26.10.31
XRAY_NM_AMD64_ASSET=Xray-linux-64.zip
XRAY_NM_AMD64_SHA256=e4bd9119f50ae7c41658b1abd0679ae06f98bd864a2907ff33f2f2cf7081b214
XRAY_NM_ARM64_ASSET=Xray-linux-arm64-v8a.zip
